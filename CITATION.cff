cff-version: 1.2.0
message: "If you use this work, please cite it as below."
type: software
title: "GSSC-S2D2: Structured Source Discrete Diffusion for Generative Semantic Scene Completion"
abstract: "Official PyTorch implementation of S²D² (Structured Source Discrete Diffusion) for LiDAR semantic scene completion. 38.8% mIoU on the SemanticKITTI hidden test at one correction step with no test-time augmentation - to our knowledge the best causal, single-sweep, single-sample result on that leaderboard to date; 39.2% with four steps and an eight-view D4 ensemble, which sits outside that predicate."
authors:
  - family-names: "Chen"
    given-names: "Shi"
    affiliation: "Fudan University; Robotics Institute, Carnegie Mellon University"
    email: "shic@andrew.cmu.edu"
  - family-names: "Ge"
    given-names: "Weifeng"
    affiliation: "College of Computer Science and Artificial Intelligence, Fudan University"
    email: "wfge@fudan.edu.cn"
# `url` is the landing page a reader should start from; `repository-code` is the source
# and `repository-artifact` the released weights. All three verified 200 logged out on
# 2026-08-25. The PS3 pool is a separate artefact and stays in `references` below.
url: "https://shichen.world/GSSC-project-page/"
repository-code: "https://github.com/BillyChern/GSSC-S2D2"
repository-artifact: "https://huggingface.co/Stone-Chern/GSSC-S2D2-checkpoints"
license: MIT
version: 2.4.2
date-released: 2026-08-25
preferred-citation:
  # type: unpublished + status: preprint. The manuscript is PUBLICLY AVAILABLE as an arXiv
  # preprint but NOT PUBLISHED: there is no journal, volume or pages to record. `unpublished`
  # says the second thing, `preprint` says the first, and both are in the CFF 1.2.0 enums --
  # see https://github.com/citation-file-format/citation-file-format/blob/1.2.0/schema.json
  # `status: submitted` was retired here BY THE PREPRINT, not by acceptance: it describes a
  # work a reader cannot retrieve, which stopped being true the moment the preprint went up.
  # `type: article` is deliberately NOT used. cffconvert renders it as BibTeX `@article`,
  # whose `journal` is a required field in the standard styles, so it would emit a broken
  # entry -- and `journal: arXiv` is not the repair: arXiv is not a journal, and no artefact
  # names a venue before acceptance.
  # On acceptance: type -> article, add `journal:`, swap `doi:` for the published DOI (keep
  # the arXiv `url:` -- it stays the preprint's permanent home), and drop `status:`.
  type: unpublished
  status: preprint
  title: "Generative Semantic Scene Completion"
  authors:
    - family-names: "Chen"
      given-names: "Shi"
      affiliation: "Fudan University; Robotics Institute, Carnegie Mellon University"
    - family-names: "Ge"
      given-names: "Weifeng"
      affiliation: "College of Computer Science and Artificial Intelligence, Fudan University"
  year: 2026
  # arXiv mints a DataCite DOI for every submission, so the preprint already HAS a persistent
  # identifier -- the old "a DOI will be added on acceptance" named the wrong trigger. `doi`
  # and `url` are both valid on a `reference`: the DOI is the identifier to cite, and the
  # version-less abs URL is the landing page, which always resolves to the newest version.
  doi: "10.48550/arXiv.2608.26737"
  url: "https://arxiv.org/abs/2608.26737"
  notes: "arXiv preprint; under review."

# The PS3 synthetic pool is a separate artefact with its own DOI, not part of this
# software release, so it is a `references` entry rather than anything under
# `preferred-citation`. Cite it IN ADDITION to the paper if you train on the pool.
# Unrelated to the `doi:` under `preferred-citation` above, which is the manuscript's arXiv DOI.
# `doi`/`url` name the IEEE DataPort deposit because that is the CITABLE identifier of
# record; `repository-artifact` names the free Hugging Face mirror, which is where the
# same (byte-identical) archives are actually downloaded from. Cite the DOI, download
# from either -- the mirror is not a second citation and must not be given as one.
references:
  - type: data
    title: "PS3-SemanticKITTI: Paired Sparse-Dense Synthetic Scenes for LiDAR Semantic Scene Completion"
    authors:
      - family-names: "Chen"
        given-names: "Shi"
      - family-names: "Ge"
        given-names: "Weifeng"
    publisher:
      name: "IEEE Dataport"
    year: 2026
    date-released: "2026-08-23"
    doi: "10.21227/nqgf-9k39"
    url: "https://dx.doi.org/10.21227/nqgf-9k39"
    repository-artifact: "https://huggingface.co/datasets/Stone-Chern/PS3-SemanticKITTI"
    notes: "Cite the DOI; download from either host. The IEEE DataPort deposit at the DOI is subscription-gated and serves files only to a signed-in session; the byte-identical Hugging Face mirror at repository-artifact needs no IEEE subscription and is what scripts/download_assets.py --synthetic-pool fetches. docs/DATASET.md also documents the local PS3 rebuild, which needs no account on either host."
