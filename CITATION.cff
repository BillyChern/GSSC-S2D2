cff-version: 1.2.0
message: "If you use this work, please cite it as below."
type: software
title: "GSSC-S2D2: Structured Source Discrete Diffusion for Generative Semantic Scene Completion"
abstract: "Official PyTorch implementation of S²D² (Structured Source Discrete Diffusion) for LiDAR semantic scene completion. 38.8% mIoU on the SemanticKITTI hidden test at one correction step with no test-time augmentation - to our knowledge the best causal, single-sweep, single-sample result on that leaderboard to date; 39.2% with four steps and an eight-view D4 ensemble, which sits outside that predicate."
authors:
  - family-names: "Chen"
    given-names: "Shi"
    affiliation: "Fudan University; Robotics Institute, Carnegie Mellon University"
    email: "shic@andrew.cmu.edu"
  - family-names: "Ge"
    given-names: "Weifeng"
    affiliation: "College of Computer Science and Artificial Intelligence, Fudan University"
    email: "wfge@fudan.edu.cn"
url: "https://github.com/BillyChern/GSSC-S2D2"
license: MIT
version: 2.4.0
date-released: 2026-08-25
preferred-citation:
  # type: unpublished + status: submitted, because the manuscript is under review and
  # not yet published anywhere. Both values are in the CFF 1.2.0 enums, and the
  # `reference` definition requires only authors/title/type, so omitting `journal` is
  # valid -- see https://github.com/citation-file-format/citation-file-format/blob/1.2.0/schema.json
  # On acceptance: type -> article, add `journal:` and `doi:`, drop `status:`.
  type: unpublished
  status: submitted
  title: "Generative Semantic Scene Completion"
  authors:
    - family-names: "Chen"
      given-names: "Shi"
      affiliation: "Fudan University; Robotics Institute, Carnegie Mellon University"
    - family-names: "Ge"
      given-names: "Weifeng"
      affiliation: "College of Computer Science and Artificial Intelligence, Fudan University"
  year: 2026
  notes: "Under review."
  # DOI omitted: the paper is under review; a DOI will be added on acceptance.

# The PS3 synthetic pool is a separate artefact with its own DOI, not part of this
# software release, so it is a `references` entry rather than anything under
# `preferred-citation`. Cite it IN ADDITION to the paper if you train on the pool.
# Unrelated to the `# DOI omitted` note above, which is about the manuscript.
# `doi`/`url` name the IEEE DataPort deposit because that is the CITABLE identifier of
# record; `repository-artifact` names the free Hugging Face mirror, which is where the
# same (byte-identical) archives are actually downloaded from. Cite the DOI, download
# from either -- the mirror is not a second citation and must not be given as one.
references:
  - type: data
    title: "PS3-SemanticKITTI: Paired Sparse-Dense Synthetic Scenes for LiDAR Semantic Scene Completion"
    authors:
      - family-names: "Chen"
        given-names: "Shi"
      - family-names: "Ge"
        given-names: "Weifeng"
    publisher:
      name: "IEEE Dataport"
    year: 2026
    date-released: "2026-08-23"
    doi: "10.21227/nqgf-9k39"
    url: "https://dx.doi.org/10.21227/nqgf-9k39"
    repository-artifact: "https://huggingface.co/datasets/Stone-Chern/PS3-SemanticKITTI"
    notes: "Cite the DOI; download from either host. The IEEE DataPort deposit at the DOI is subscription-gated and serves files only to a signed-in session; the byte-identical Hugging Face mirror at repository-artifact needs no IEEE subscription and is what scripts/download_assets.py --synthetic-pool fetches. docs/DATASET.md also documents the local PS3 rebuild, which needs no account on either host."
